# Connection string Neon dari PROJECT BARU yang kosong. Jangan pakai database situs yang sedang online.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Teks acak minimal 32 karakter (contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=

# Opsional: penyimpanan file di Vercel Blob. Kosong = file disimpan di folder ./uploads (cukup untuk uji lokal).
BLOB_READ_WRITE_TOKEN=

# Opsional: popup penjelasan komponen 3D oleh AI. Kosong = memakai penjelasan bawaan.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
